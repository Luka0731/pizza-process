{
  "$schema" : "https://json-schema.axonivy.com/14.0/project/process.json",
  "id" : "19FEA246E1998402",
  "config" : {
    "data" : "ch.frox.pizzaprocess.PizzaWorkerProcessData"
  },
  "elements" : [ {
      "id" : "f3",
      "type" : "TaskSwitchGateway",
      "config" : {
        "tasks" : [ {
            "id" : "TaskA",
            "name" : "start baking",
            "responsible" : {
              "roles" : [
                "SYSTEM"
              ]
            }
          }, {
            "id" : "TaskB",
            "name" : "listen for questions",
            "responsible" : {
              "roles" : [
                "SYSTEM"
              ]
            }
          } ]
      },
      "visual" : {
        "at" : { "x" : 280, "y" : 136 }
      },
      "connect" : [
        { "id" : "f6", "to" : "f50", "condition" : "ivp==\"TaskB.ivp\"" },
        { "id" : "f9", "to" : "f8", "via" : [ { "x" : 280, "y" : 248 } ], "condition" : "ivp==\"TaskA.ivp\"" }
      ]
    }, {
      "id" : "f50",
      "type" : "Alternative",
      "visual" : {
        "at" : { "x" : 332, "y" : 136 }
      },
      "connect" : [
        { "id" : "f51", "to" : "f5" }
      ]
    }, {
      "id" : "f5",
      "type" : "TaskSwitchEvent",
      "name" : "ask for pizza",
      "config" : {
        "task" : {
          "name" : "Wait for the customer to ask for the pizza",
          "description" : "Order <%=in1.orderId%>",
          "responsible" : {
            "roles" : [
              "SYSTEM"
            ]
          },
          "delay" : "new Duration(0, 0, 30, 0, 0, 0)",
          "customFields" : [
            { "name" : "signalCode", "type" : "STRING", "value" : "\"pizzaprocess:order:asked:\" + in1.orderId.toString()" }
          ]
        },
        "output" : {
          "map" : {
            "out" : "in1",
            "out.customerQuestion" : "ivy.task.customFields().stringField(\"signalPayload\").getOrNull()"
          }
        }
      },
      "visual" : {
        "at" : { "x" : 384, "y" : 136 },
        "icon" : "std:Signal"
      },
      "connect" : [
        { "id" : "f7", "to" : "f10" }
      ]
    }, {
      "id" : "f8",
      "type" : "UserTask",
      "name" : "bake the pizza",
      "config" : {
        "dialog" : "ch.frox.pizzaprocess.BakeThePizzaTask:start(java.util.UUID,String,String)",
        "call" : {
          "map" : {
            "param.orderId" : "in.orderId",
            "param.deliveryAddress" : "in.deliveryAddress",
            "param.deliveryRole" : "in.deliveryRole"
          }
        },
        "task" : {
          "name" : "Bake the pizza",
          "description" : "Order <%=in.orderId%>",
          "responsible" : {
            "roles" : [
              "PizzaChef"
            ]
          }
        },
        "output" : {
          "map" : {
            "out" : "in",
            "out.deliveryAddress" : "result.deliveryAddress",
            "out.deliveryRole" : "result.deliveryRole",
            "out.orderId" : "result.orderId"
          }
        }
      },
      "visual" : {
        "at" : { "x" : 384, "y" : 248 }
      },
      "connect" : [
        { "id" : "f26", "to" : "f25" }
      ]
    }, {
      "id" : "f10",
      "type" : "UserTask",
      "name" : "calm customer down",
      "config" : {
        "dialog" : "ch.frox.pizzaprocess.CalmCustomerDownTask:start(java.util.UUID,String)",
        "call" : {
          "map" : {
            "param.orderId" : "in.orderId",
            "param.customerQuestion" : "in.customerQuestion"
          }
        },
        "task" : {
          "name" : "Calm the customer down",
          "description" : "Order <%=in.orderId%>",
          "responsible" : {
            "roles" : [
              "Clerk"
            ]
          }
        }
      },
      "visual" : {
        "at" : { "x" : 536, "y" : 136 }
      },
      "connect" : [
        { "id" : "f11", "to" : "f50", "via" : [ { "x" : 544, "y" : 80 }, { "x" : 332, "y" : 80 } ] }
      ]
    }, {
      "id" : "f16",
      "type" : "TaskEnd",
      "name" : "pizza delivered",
      "visual" : {
        "at" : { "x" : 736, "y" : 368 },
        "icon" : "std:Terminate"
      }
    }, {
      "id" : "f22",
      "type" : "SignalStartEvent",
      "name" : "order recived",
      "config" : {
        "signalCode" : "pizzaprocess:order:placed",
        "output" : {
          "map" : {
            "out.orderId" : "signal.getSignalData() as java.util.UUID"
          }
        }
      },
      "visual" : {
        "at" : { "x" : 176, "y" : 136 }
      },
      "connect" : [
        { "id" : "f23", "to" : "f3", "var" : "in1" }
      ]
    }, {
      "id" : "f25",
      "type" : "UserTask",
      "name" : "deliver the pizza",
      "config" : {
        "dialog" : "ch.frox.pizzaprocess.DeliverThePizzaTask:start(java.util.UUID,String,String)",
        "call" : {
          "map" : {
            "param.orderId" : "in.orderId",
            "param.deliveryRole" : "in.deliveryRole",
            "param.deliveryAddress" : "in.deliveryAddress"
          }
        },
        "task" : {
          "name" : "Deliver the pizza to <%=in.deliveryAddress%>",
          "description" : "Order <%=in.orderId%>",
          "responsible" : {
            "type" : "ROLE_FROM_ATTRIBUTE",
            "script" : "in.deliveryRole"
          }
        },
        "output" : {
          "map" : {
            "out" : "in",
            "out.deliveryAddress" : "in.deliveryAddress",
            "out.deliveryRole" : "in.deliveryRole",
            "out.orderId" : "in.orderId"
          }
        }
      },
      "visual" : {
        "at" : { "x" : 384, "y" : 368 }
      },
      "connect" : [
        { "id" : "f28", "to" : "f27" }
      ]
    }, {
      "id" : "f27",
      "type" : "DialogCall",
      "name" : "recive payment",
      "config" : {
        "dialog" : "ch.frox.pizzaprocess.ReciveThePayment:start(java.util.UUID)",
        "call" : {
          "map" : {
            "param.orderId" : "in.orderId"
          }
        }
      },
      "visual" : {
        "at" : { "x" : 584, "y" : 368 }
      },
      "connect" : [
        { "id" : "f29", "to" : "f16" }
      ]
    } ],
  "layout" : {
    "lanes" : [ {
        "name" : "Pizza Worker",
        "offset" : 56,
        "size" : 368,
        "lanes" : [ {
            "name" : "Clerk",
            "size" : 136
          }, {
            "name" : "Pizza Chef",
            "size" : 120
          }, {
            "name" : "Delivery Boy",
            "size" : 112
          } ]
      } ]
  }
}