{
  "$schema" : "https://json-schema.axonivy.com/14.0/project/process.json",
  "id" : "19FEA23D2C6C7782",
  "config" : {
    "data" : "ch.frox.pizzaprocess.PizzaCustomerProcessData"
  },
  "elements" : [ {
      "id" : "f0",
      "type" : "RequestStart",
      "name" : "hungry for pizza",
      "config" : {
        "signature" : "startPizzaCustomerProcess"
      },
      "visual" : {
        "at" : { "x" : 136, "y" : 64 }
      },
      "connect" : [
        { "id" : "f2", "to" : "f3" }
      ]
    }, {
      "id" : "f1",
      "type" : "TaskEnd",
      "name" : "hunger satisfied",
      "visual" : {
        "at" : { "x" : 1080, "y" : 64 },
        "icon" : "std:Terminate"
      }
    }, {
      "id" : "f3",
      "type" : "DialogCall",
      "name" : "select a pizza",
      "config" : {
        "dialog" : "ch.frox.pizzaprocess.SelectAPizzaDialog:start()",
        "output" : {
          "map" : {
            "out.orderId" : "result.orderId"
          }
        }
      },
      "visual" : {
        "at" : { "x" : 296, "y" : 64 }
      },
      "connect" : [
        { "id" : "f10", "to" : "f9" }
      ]
    }, {
      "id" : "f7",
      "type" : "TaskSwitchGateway",
      "config" : {
        "tasks" : [ {
            "id" : "TaskB",
            "name" : "ask for the pizza",
            "responsible" : {
              "roles" : [
                "SYSTEM"
              ]
            }
          }, {
            "id" : "TaskA",
            "name" : "wait for the pizza",
            "skipTasklist" : true
          } ]
      },
      "visual" : {
        "at" : { "x" : 664, "y" : 64 }
      },
      "connect" : [
        { "id" : "f30", "to" : "f50", "via" : [ { "x" : 664, "y" : 168 } ], "condition" : "ivp==\"TaskB.ivp\"" },
        { "id" : "f42", "to" : "f43", "condition" : "ivp==\"TaskA.ivp\"" }
      ]
    }, {
      "id" : "f9",
      "type" : "DialogCall",
      "name" : "order a pizza",
      "config" : {
        "dialog" : "ch.frox.pizzaprocess.OrderAPizzaDialog:start(java.util.UUID)",
        "call" : {
          "map" : {
            "param.orderId" : "in.orderId"
          }
        },
        "output" : {
          "map" : {
            "out.orderId" : "result.orderId"
          }
        }
      },
      "visual" : {
        "at" : { "x" : 496, "y" : 64 }
      },
      "connect" : [
        { "id" : "f40", "to" : "f7", "var" : "in1" }
      ]
    }, {
      "id" : "f14",
      "type" : "DialogCall",
      "name" : "ask for the pizza",
      "config" : {
        "dialog" : "ch.frox.pizzaprocess.AskForThePizzaDialog:start(java.util.UUID)",
        "call" : {
          "map" : {
            "param.orderId" : "in.orderId"
          }
        }
      },
      "visual" : {
        "at" : { "x" : 920, "y" : 168 }
      },
      "connect" : [
        { "id" : "f45", "to" : "f50", "via" : [ { "x" : 920, "y" : 120 }, { "x" : 712, "y" : 120 } ] }
      ]
    }, {
      "id" : "f21",
      "type" : "DialogCall",
      "name" : "eat the pizza",
      "config" : {
        "dialog" : "ch.frox.pizzaprocess.EatThePizzaDialog:start(java.util.UUID)",
        "call" : {
          "map" : {
            "param.orderId" : "in.orderId"
          }
        }
      },
      "visual" : {
        "at" : { "x" : 920, "y" : 64 }
      },
      "connect" : [
        { "id" : "f22", "to" : "f1", "color" : "default" }
      ]
    }, {
      "id" : "f26",
      "type" : "ProcessAnnotation",
      "name" : [
        "* a new empty pizza_order entity gets created",
        "* you can select pizzas. Every selection gets saved to the order",
        "* click the done button to save the order in the db and move along to the next order"
      ],
      "visual" : {
        "at" : { "x" : 216, "y" : 328 },
        "size" : { "width" : 352, "height" : 84 }
      },
      "connect" : [
        { "id" : "f27", "to" : "f3" }
      ]
    }, {
      "id" : "f28",
      "type" : "ProcessAnnotation",
      "name" : [
        "* here you put in your data, like address. It fills the order data",
        "* press finish buton to send the order off"
      ],
      "visual" : {
        "at" : { "x" : 543, "y" : 359 },
        "size" : { "width" : 287, "height" : 63 }
      },
      "connect" : [
        { "id" : "f29", "to" : "f9" }
      ]
    }, {
      "id" : "f50",
      "type" : "Alternative",
      "visual" : {
        "at" : { "x" : 712, "y" : 168 }
      },
      "connect" : [
        { "id" : "f51", "to" : "f32" }
      ]
    }, {
      "id" : "f32",
      "type" : "TaskSwitchEvent",
      "name" : "60 minuts",
      "config" : {
        "task" : {
          "name" : "Where is my pizza?",
          "description" : "Order <%=in1.orderId%>",
          "delay" : "new Duration(0, 0, 0, 0, 1, 0)",
          "customFields" : [
            { "name" : "signalCode", "type" : "STRING", "value" : "\"pizzaprocess:order:askable:\" + in1.orderId.toString()" }
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 768, "y" : 168 },
        "icon" : "std:Timer"
      },
      "connect" : [
        { "id" : "f33", "to" : "f14", "color" : "default" }
      ]
    }, {
      "id" : "f43",
      "type" : "TaskSwitchEvent",
      "name" : "pizza recived",
      "config" : {
        "task" : {
          "name" : "Your pizza is here, enjoy it",
          "description" : "Order <%=in1.orderId%>",
          "delay" : "new Duration(0, 0, 30, 0, 0, 0)",
          "customFields" : [
            { "name" : "signalCode", "type" : "STRING", "value" : "\"pizzaprocess:order:delivered:\" + in1.orderId.toString()" }
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 768, "y" : 64 },
        "icon" : "std:Signal"
      },
      "connect" : [
        { "id" : "f44", "to" : "f21", "color" : "default" }
      ]
    } ],
  "layout" : {
    "lanes" : [ {
        "name" : "Pizza Customer",
        "offset" : 8,
        "size" : 248,
        "lanes" : [ ]
      } ]
  }
}